project_id = "YOUR-PROD-PROJECT-ID"
impersonate_service_account = "magento-infra-deployer@YOUR-PROD-PROJECT-ID.iam.gserviceaccount.com"
region            = "us-west1"
zone              = "us-west1-a"
network_self_link = "projects/YOUR-PROD-PROJECT-ID/global/networks/YOUR-VPC"
network_name      = "YOUR-VPC"
subnetwork_self_link = "projects/YOUR-PROD-PROJECT-ID/regions/us-west1/subnetworks/YOUR-SUBNET"

labels = {
  owner = "ecom-engineering"
}

cloud_sql_tier             = "db-custom-2-8192"
cloud_sql_disk_size_gb     = 200
cloud_sql_app_password     = "REPLACE_WITH_LOCAL_OR_CI_SECRET"
cloud_sql_release_password = "REPLACE_WITH_LOCAL_OR_CI_SECRET"

redis_memory_size_gb          = 5
redis_transit_encryption_mode = "DISABLED"

opensearch_node_count             = 3
opensearch_node_private_ips       = []
opensearch_machine_type           = "e2-standard-4"
opensearch_version                = "3.6.0"
opensearch_heap_size              = "2g"
opensearch_data_disk_size_gb      = 200

web_mig_source_ranges = []
web_mig_source_tags   = ["magento-prod-web", "magento-prod-worker", "magento-prod-release"]

runtime_image     = "us-central1-docker.pkg.dev/YOUR-PROD-PROJECT-ID/magento/magento-modern:COMMIT_SHA"
runtime_image_sha = "COMMIT_SHA"

web_machine_type    = "e2-standard-4"
worker_machine_type = "e2-standard-2"
web_target_size     = 3
worker_target_size  = 1

# Google external HTTP(S) load balancer health check and proxy ranges.
web_runtime_source_ranges = ["130.211.0.0/22", "35.191.0.0/16"]
web_runtime_source_tags   = []

worker_consumers             = ["async.operations.all"]
worker_consumer_max_messages = 10000
cron_interval_seconds        = 60

magento_base_url                = "https://www.example.com/"
magento_secure_base_url         = "https://www.example.com/"
magento_opensearch_index_prefix = "magento_prod"

# Keep disabled until the production edge phase is explicitly ready.
enable_external_https_lb                         = false
external_https_lb_domains                        = []
external_https_lb_existing_certificate_self_links = []
external_https_lb_dns_managed_zone               = null
external_https_lb_dns_record_name                = null
external_https_lb_enable_http_redirect           = true
external_https_lb_enable_cdn                     = false
external_https_lb_security_policy                = null

runtime_secret_accessor_members = []
release_secret_accessor_members = []
build_secret_accessor_members   = []
