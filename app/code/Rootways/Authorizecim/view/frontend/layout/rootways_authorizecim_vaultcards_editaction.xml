<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <head>
        <title>Edit Saved Cards</title>
        <css src="Rootways_Authorizecim::css/custom.css"/>
    </head>
    <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument translate="true" name="title" xsi:type="string">Edit Card</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Rootways\Authorizecim\Block\Cards\Edit"
                   name="rw-authorizecim-card-edit"
                   template="Rootways_Authorizecim::vault/customer_account/edit_card.phtml"
                   cacheable="false">
                <arguments>
                    <argument name="attribute_data" xsi:type="object">Magento\Customer\Block\DataProviders\AddressAttributeData</argument>
                    <argument name="post_code_config" xsi:type="object">Magento\Customer\Block\DataProviders\PostCodesPatternsAttributeData</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
