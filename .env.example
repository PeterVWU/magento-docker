COMPOSE_PROJECT_NAME=magento-modern

APP_HOST=localhost
APP_BASE_URL=http://localhost:8080/
APP_ADMIN_FRONTNAME=admin

MAGENTO_VERSION=2.4.8-p4
PHP_VERSION=8.3

MYSQL_DATABASE=magento
MYSQL_USER=magento
MYSQL_PASSWORD=magento
MYSQL_ROOT_PASSWORD=magento-root

REDIS_CACHE_DB=0
REDIS_PAGE_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_LOCK_DB=3

OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200

MAGENTO_ADMIN_USER=admin
MAGENTO_ADMIN_PASSWORD=Admin123!Admin123!
MAGENTO_ADMIN_FIRSTNAME=Admin
MAGENTO_ADMIN_LASTNAME=User
MAGENTO_ADMIN_EMAIL=admin@example.test

MAGENTO_LOCALE=en_US
MAGENTO_TIMEZONE=America/Los_Angeles
MAGENTO_CURRENCY=USD

