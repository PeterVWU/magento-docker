#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
output_dir="${1:-$repo_root/var/import/production-derived/ecom7-first-slice}"

mkdir -p "$output_dir"

run_query() {
    local sql="$1"
    local output="$2"

    docker compose exec -T db mysql \
        --batch \
        -uroot \
        -pmagento-root \
        -D vusa_db0 \
        -e "$sql" > "$output"
}

cd "$repo_root"

cat docs/ecom-7/source-selection.sql docs/ecom-7/dataset-assembly.sql \
    | docker compose exec -T db mysql -uroot -pmagento-root -D vusa_db0 >/dev/null

run_query \
    "SELECT o.* FROM sales_order o JOIN ecom7_order_sample sample ON sample.order_id = o.entity_id ORDER BY o.entity_id" \
    "$output_dir/orders.tsv"
run_query \
    "SELECT item.* FROM sales_order_item item JOIN ecom7_order_sample sample ON sample.order_id = item.order_id ORDER BY item.item_id" \
    "$output_dir/order-items.tsv"
run_query \
    "SELECT address.* FROM sales_order_address address JOIN ecom7_address_sample sample ON sample.entity_id = address.entity_id ORDER BY address.entity_id" \
    "$output_dir/order-addresses.tsv"
run_query \
    "SELECT customer.* FROM customer_entity customer JOIN ecom7_customer_sample sample ON sample.customer_id = customer.entity_id ORDER BY customer.entity_id" \
    "$output_dir/customers.tsv"
run_query \
    "SELECT address.* FROM customer_address_entity address JOIN ecom7_customer_address_sample sample ON sample.entity_id = address.entity_id ORDER BY address.entity_id" \
    "$output_dir/customer-addresses.tsv"
run_query \
    "SELECT product.* FROM catalog_product_entity product JOIN ecom7_product_sample sample ON sample.product_id = product.entity_id ORDER BY product.entity_id" \
    "$output_dir/products.tsv"
run_query \
    "SELECT link.* FROM catalog_product_super_link link JOIN ecom7_order_item_product_sample sample ON sample.product_id = link.product_id ORDER BY link.parent_id, link.product_id" \
    "$output_dir/configurable-links.tsv"
run_query \
    "SELECT rep.* FROM salesrep rep JOIN ecom7_order_sample sample ON sample.order_id = rep.order_id ORDER BY rep.salesrep_id" \
    "$output_dir/salesrep.tsv"
run_query \
    "SELECT source.* FROM vapewholesaleusa_ordersource_ordersource source JOIN ecom7_order_sample sample ON sample.order_id = source.order_id ORDER BY source.entity_id" \
    "$output_dir/order-source.tsv"

{
    printf 'file\trows\n'
    printf 'orders.tsv\t%s\n' \
        "$(docker compose exec -T db mysql -N -B -uroot -pmagento-root -D vusa_db0 -e "SELECT COUNT(*) FROM sales_order o JOIN ecom7_order_sample sample ON sample.order_id = o.entity_id")"
    printf 'order-items.tsv\t%s\n' \
        "$(docker compose exec -T db mysql -N -B -uroot -pmagento-root -D vusa_db0 -e "SELECT COUNT(*) FROM sales_order_item item JOIN ecom7_order_sample sample ON sample.order_id = item.order_id")"
    printf 'order-addresses.tsv\t%s\n' \
        "$(docker compose exec -T db mysql -N -B -uroot -pmagento-root -D vusa_db0 -e "SELECT COUNT(*) FROM sales_order_address address JOIN ecom7_address_sample sample ON sample.entity_id = address.entity_id")"
    printf 'customers.tsv\t%s\n' \
        "$(docker compose exec -T db mysql -N -B -uroot -pmagento-root -D vusa_db0 -e "SELECT COUNT(*) FROM customer_entity customer JOIN ecom7_customer_sample sample ON sample.customer_id = customer.entity_id")"
    printf 'customer-addresses.tsv\t%s\n' \
        "$(docker compose exec -T db mysql -N -B -uroot -pmagento-root -D vusa_db0 -e "SELECT COUNT(*) FROM customer_address_entity address JOIN ecom7_customer_address_sample sample ON sample.entity_id = address.entity_id")"
    printf 'products.tsv\t%s\n' \
        "$(docker compose exec -T db mysql -N -B -uroot -pmagento-root -D vusa_db0 -e "SELECT COUNT(*) FROM catalog_product_entity product JOIN ecom7_product_sample sample ON sample.product_id = product.entity_id")"
    printf 'configurable-links.tsv\t%s\n' \
        "$(docker compose exec -T db mysql -N -B -uroot -pmagento-root -D vusa_db0 -e "SELECT COUNT(*) FROM catalog_product_super_link link JOIN ecom7_order_item_product_sample sample ON sample.product_id = link.product_id")"
    printf 'salesrep.tsv\t%s\n' \
        "$(docker compose exec -T db mysql -N -B -uroot -pmagento-root -D vusa_db0 -e "SELECT COUNT(*) FROM salesrep rep JOIN ecom7_order_sample sample ON sample.order_id = rep.order_id")"
    printf 'order-source.tsv\t%s\n' \
        "$(docker compose exec -T db mysql -N -B -uroot -pmagento-root -D vusa_db0 -e "SELECT COUNT(*) FROM vapewholesaleusa_ordersource_ordersource source JOIN ecom7_order_sample sample ON sample.order_id = source.order_id")"
} > "$output_dir/export-summary.tsv"
